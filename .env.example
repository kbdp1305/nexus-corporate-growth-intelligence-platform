# Salin ke .env lalu isi nilainya. .env tidak masuk git.
# Format KEY=nilai (format dotenv; bukan $env:KEY=... milik PowerShell)
OPENAI_API_KEY=

# Login dashboard: password awal untuk semua akun baru (rm-001 … rm-040, supervisor).
# Kosongkan → password acak per akun, ditulis ke outputs/app/akun_awal.csv.
APP_DEMO_PASSWORD=
